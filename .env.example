# ===== Life Blind Box — Environment Variables =====
# Copy this file to `.env.local` (for Next.js app) and
# `mini-services/voice-game/.env` (for the voice-game service),
# then fill in the real values. NEVER commit the filled-in files.

# ===== OpenAI (optional, only if you want to call OpenAI directly) =====
# Note: If you are running in the Z.ai sandbox environment, the voice-game
# service uses the internal Z.ai gateway (configured via /etc/.z-ai-config)
# and these OpenAI vars are NOT required.
# If you are running outside the sandbox, set OPENAI_API_KEY to use OpenAI,
# or set up your own OpenAI-compatible gateway.
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_STT_MODEL=whisper-1

# ===== Voice-game service (mini-services/voice-game/.env) =====
# Override the LLM model used by the voice-game service (default: glm-4-plus)
LLM_MODEL=glm-4-plus
# Override the TTS voice (default: tongtong)
TTS_VOICE=tongtong

# ===== Next.js app (.env.local) =====
# SQLite database URL for Prisma
DATABASE_URL=file:/home/z/my-project/db/custom.db
