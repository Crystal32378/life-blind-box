node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ===== Build output =====
/.next/
/out/
/build
/dist

# ===== Testing =====
/coverage

# ===== Misc OS / editor =====
.DS_Store
*.pem
Thumbs.db

# ===== Debug logs =====
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
