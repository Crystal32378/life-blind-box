# ===== Life Blind Box — Environment Variables =====
# Copy this file to `.env.local` (for Next.js app) and
# `mini-services/voice-game/.env` (for the voice-game service),
# then fill in the real values. NEVER commit the filled-in files.

# ===== OpenAI =====
# Server-side only. Set this in Render's voice service; never expose it to Next.js.
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_ASR_MODEL=gpt-4o-mini-transcribe

# ===== OpenAI TTS =====
# Voice options: onyx, fable, coral, nova, marin, alloy
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=fable
OPENAI_TTS_RESPONSE_FORMAT=wav

# ===== Voice-game service (mini-services/voice-game/.env) =====
# Render injects PORT automatically. Local default: 3003.
PORT=3003
# Comma-separated browser origins allowed to connect to Socket.IO.
CORS_ORIGIN=http://localhost:3000

# ===== Beta quota / kill switch =====
# Set to "true" to completely disable beta and block new games.
BETA_DISABLED=false
# Per-IP daily game limit.
PER_IP_DAILY_LIMIT=5
# Global daily game cap across all users.
GLOBAL_DAILY_CAP=200
# Max turns per game.
MAX_TURNS_PER_GAME=5
# Max audio upload size in bytes. Default: 2MB = 2097152.
MAX_AUDIO_BYTES=2097152
# Max audio duration in seconds. Used as a UI hint.
MAX_AUDIO_SECONDS=60

# ===== Usage logging =====
# Where to write JSONL usage logs.
USAGE_LOG_FILE=/tmp/voice-game-usage.jsonl

# ===== P0-3: Founder / tester mode =====
# Enable founder mode (allows founder to bypass public quota via ?founder=TOKEN)
FOUNDER_MODE_ENABLED=false
# Founder daily limit (much higher than public, for testing all scene categories)
FOUNDER_DAILY_LIMIT=100
# Founder token — generate a strong random token, NEVER commit the real value
# Usage: https://your-app/?founder=YOUR_TOKEN_HERE
FOUNDER_TOKEN=

# ===== Provider mode =====
# Render uses OpenAI exclusively. Z.ai remains optional for legacy sandbox runs.
LLM_PROVIDER=openai
ASR_PROVIDER=openai
TTS_PROVIDER=openai

# ===== z.ai config (for Railway/staging — write to .z-ai-config via setup-config.ts) =====
# Only needed if using z.ai providers. On sandbox, /etc/.z-ai-config is pre-installed.
# ZAI_API_KEY=
# ZAI_BASE_URL=https://internal-api.z.ai/v1
# ZAI_CHAT_ID=
# ZAI_USER_ID=
# ZAI_TOKEN=

# ===== Next.js frontend =====
NEXT_PUBLIC_VOICE_GAME_URL=http://localhost:3003
