# ===== Life Blind Box — Environment Variables =====
# Copy this file to `.env.local` (for Next.js app) and
# `mini-services/voice-game/.env` (for the voice-game service),
# then fill in the real values. NEVER commit the filled-in files.

# ===== OpenAI / OpenAI-compatible gateway =====
# If running in the Z.ai sandbox environment, the voice-game service uses
# the internal Z.ai gateway configured via `/etc/.z-ai-config`, so OpenAI vars
# are not required.
# If running outside the sandbox, set OPENAI_API_KEY to use OpenAI directly,
# or configure your own OpenAI-compatible gateway.
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1

# ===== OpenAI TTS fallback =====
# Used when TTS_PROVIDER=openai or auto.
# For Chinese, Z.ai remains the primary voice path for naturalness.
# For English, OpenAI TTS can become the primary provider.
# Voice options: onyx, fable, coral, nova, marin, alloy
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=fable
OPENAI_TTS_RESPONSE_FORMAT=wav

# ===== Voice-game service (mini-services/voice-game/.env) =====
# Override the LLM model used by the voice-game service.
LLM_MODEL=glm-4-plus
# Override the Z.ai TTS voice.
TTS_VOICE=tongtong
# TTS provider: 'zai' (Z.ai only) | 'openai' (OpenAI only) | 'auto' (Z.ai first, fallback OpenAI)
TTS_PROVIDER=auto

# ===== Beta quota / kill switch =====
# Set to "true" to completely disable beta and block new games.
BETA_DISABLED=false
# Per-IP daily game limit.
PER_IP_DAILY_LIMIT=5
# Global daily game cap across all users.
GLOBAL_DAILY_CAP=200
# Max turns per game.
MAX_TURNS_PER_GAME=5
# Max audio upload size in bytes. Default: 2MB = 2097152.
MAX_AUDIO_BYTES=2097152
# Max audio duration in seconds. Used as a UI hint.
MAX_AUDIO_SECONDS=60

# ===== Usage logging =====
# Where to write JSONL usage logs.
USAGE_LOG_FILE=/tmp/voice-game-usage.jsonl

# ===== Next.js app (.env.local) =====
# SQLite database URL for Prisma.
DATABASE_URL=file:/home/z/my-project/db/custom.db
